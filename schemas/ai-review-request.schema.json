{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "source_sha256",
    "skill_version",
    "canonical_bundle_fingerprint",
    "review_scope",
    "instructions",
    "reason_codes",
    "targets",
    "allowed_operations",
    "prohibited_operations",
    "truncation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^ai-review-request-[0-9a-f]{16}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skill_version": {
      "const": "1.8.1"
    },
    "canonical_bundle_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_scope": {
      "const": "readable_projection_only"
    },
    "trigger": {
      "type": "object"
    },
    "instructions": {
      "type": "object"
    },
    "reason_codes": {
      "type": "array"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_type",
          "target_id",
          "reason_codes"
        ],
        "properties": {
          "target_type": {
            "enum": [
              "table",
              "element_range",
              "advisory"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "reason_codes": {
            "type": "array"
          },
          "source_locator": {
            "type": "object"
          },
          "element_ids": {
            "type": "array"
          },
          "heading_path": {
            "type": "array"
          },
          "canonical": {
            "type": "object"
          },
          "faithful_markdown": {
            "type": "string"
          },
          "allowed_outcomes": {
            "type": "array"
          },
          "projection_write_allowed": {
            "type": "boolean"
          },
          "canonical_mutation_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "allowed_operations": {
      "type": "array"
    },
    "prohibited_operations": {
      "type": "array"
    },
    "truncation": {
      "type": "array"
    }
  }
}
