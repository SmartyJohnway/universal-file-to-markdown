{
  "schema_version": "1.0",
  "package_type": "ai_skill",
  "skill_name": "universal-file-to-markdown",
  "version_source": "VERSION",
  "required_paths": [
    "SKILL.md", "VERSION", "VERSIONING.md", "README.md", "README.zh-TW.md",
    "CHANGELOG.md", "CHANGELOG.zh-TW.md", "requirements.txt", "package-manifest.json",
    "scripts/", "schemas/", "references/"
  ],
  "optional_paths": [
    "docs/DEPENDENCY_POLICY.md", "docs/PROJECT_STATUS.md", "docs/RUNTIME_COMPATIBILITY.md",
    "docs/SECURITY_MODEL.md", "docs/SOURCE_LOCATOR_CONTRACT.md", "LICENSE", "THIRD_PARTY_NOTICES.md"
  ],
  "excluded_patterns": [
    ".git/**", ".github/**", ".venv/**", ".qualification/**", ".pytest_cache/**",
    "__pycache__/**", "**/__pycache__/**", "**/*.pyc", "**/*.pyo", "**/*.log",
    "**/*.tmp", "**/*.bak", "**/*.swp", "**/.DS_Store", "**/Thumbs.db", "dist/**", "build/**", "tests/**"
  ],
  "entrypoints": ["scripts/router.py", "scripts/capability_probe.py", "scripts/validate_bundle.py"],
  "qualification_commands": [
    "python scripts/build_skill_package.py --output dist --verify",
    "python scripts/validate_skill_package.py dist/universal-file-to-markdown-<VERSION>.zip",
    "python scripts/qualify_release_package.py --archive dist/universal-file-to-markdown-<VERSION>.zip"
  ]
}
